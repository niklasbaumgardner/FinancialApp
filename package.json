{
  "name": "budgetapp",
  "version": "1.0.0",
  "scripts": {
    "tw-watch": "npx @tailwindcss/cli -i ./finapp/static/css/src/tailwind.css -o ./finapp/static/css/src/tw-out.css --watch",
    "tw-build": "npx @tailwindcss/cli -i ./finapp/static/css/src/tailwind.css -o ./finapp/static/css/src/tw-out.css",
    "wp-build": "webpack --progress --config ./finapp/static/webpack.config.js --mode=production",
    "wp-watch": "webpack --progress --config ./finapp/static/webpack.config.js --watch --mode=development",
    "build-all": "npm run tw-build && npm run wp-build",
    "es-build": "node ./finapp/static/esbuild.config.mjs",
    "es-watch": "node ./finapp/static/esbuild.config.mjs --watch"
  },
  "author": "Niklas Baumgardner",
  "devDependencies": {
    "esbuild": "^0.28.0",
    "esbuild-clean-plugin": "^2.0.0"
  },
  "dependencies": {
    "@awesome.me/webawesome-pro": "^3.7.0",
    "@tailwindcss/cli": "^4.3.0",
    "ag-charts-community": "^13.3.0",
    "ag-grid-community": "^35.3.0",
    "lit": "^3.3.2",
    "tailwindcss": "^4.2.2"
  }
}
